<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>Warm Cache</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- The design draws its own 44px mono status row (clock left, WARM CACHE /
	     READING ALOUD right). Without this the system bar sits above it and the
	     clock appears twice. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Warm Cache listens while you answer a question out loud.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your spoken answers are transcribed on this device so they can be scored.</string>
	<!-- Injected from ios/Config/*.xcconfig. WCAPIKey comes from the gitignored
	     Secrets.xcconfig; an empty value yields a clean 401 rather than a
	     fallback that quietly authenticates with a secret published in the repo. -->
	<key>WCBaseURL</key>
	<string>$(WC_BASE_URL)</string>
	<key>WCAPIKey</key>
	<string>$(WC_API_KEY)</string>
	<!-- Debug points at http://localhost:8083. NSAllowsLocalNetworking permits
	     cleartext to loopback/.local/LAN only — production https stays fully
	     protected, unlike NSAllowsArbitraryLoads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Newsreader.ttf</string>
		<string>Newsreader-Italic.ttf</string>
		<string>IBMPlexSans.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
		<string>IBMPlexMono-SemiBold.ttf</string>
	</array>
</dict>
</plist>
