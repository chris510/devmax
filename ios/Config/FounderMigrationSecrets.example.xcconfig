// Copy to FounderMigrationSecrets.xcconfig (gitignored) only for the controlled
// direct-device migration build. Delete it immediately after the founder claim.
//
// This short-lived value is accepted only by the explicit Apple owner-claim
// endpoint. It is not a general API credential. Never paste API_KEY or
// CRON_SECRET here.

WC_FOUNDER_CLAIM_TOKEN = paste-the-one-time-founder-claim-token-here
