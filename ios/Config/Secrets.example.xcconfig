// Copy to Secrets.xcconfig (gitignored) and fill in.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Normal Debug and Release builds force-clear both authentication bootstrap
// settings after including this file. The one-time founder claim belongs only in
// FounderMigrationSecrets.xcconfig; keeping it separate prevents unrelated Debug
// builds from carrying it during the migration window.

WC_API_KEY =
WC_FOUNDER_CLAIM_TOKEN =
