// Copy to Secrets.xcconfig (gitignored) and fill in.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// WC_API_KEY is needed only by the founder migration build and must match the
// API_KEY set on the server:
//
//     the API_KEY variable on the Railway service
//
// This value ends up inside the app binary and is extractable with `strings`.
// New public builds leave it empty and use Sign in with Apple plus Keychain
// bearer credentials. Never reuse CRON_SECRET here.

WC_API_KEY = paste-the-server-API_KEY-here
