#include "Base.xcconfig"
#include? "Secrets.xcconfig"

// The Railway public domain (project `profound-purpose`, service `devmax`).
WC_BASE_URL = https:/$()/devmax-production.up.railway.app

// Must track APNS_USE_SANDBOX on the server: development <-> true,
// production <-> false. A mismatch fails silently as BadDeviceToken.
// Release archives are distributed by TestFlight/App Store and receive
// production device tokens. Direct device testing must use Debug instead.
WC_APS_ENVIRONMENT = production
