# Postgres connection string, async driver.
#
# Local development, against your own cluster:
DATABASE_URL=postgresql+asyncpg://postgres@localhost/devmax
#
# On Railway this is set as a service variable rather than here, referencing the
# Postgres service so it resolves to the private address:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#
# Two things to know whichever provider you use:
#   * The scheme must be `postgresql+asyncpg://`. Railway and Neon both hand you
#     `postgresql://`; rewrite it.
#   * A pasted console URL often ends `?sslmode=require&channel_binding=require`.
#     Those are libpq-only and asyncpg rejects them outright — db.py strips them and
#     applies the equivalent intent itself, so either form is safe to paste.
#
# To reach Railway's Postgres from your laptop, use DATABASE_PUBLIC_URL and keep the
# `?sslmode=require`: the proxy's certificate is self-signed, and without an explicit
# sslmode the app defaults to full verification and will reject it.

# The app refuses to start if either of these is missing, empty, a known placeholder,
# or equal to the other one. Generate each separately:
#   openssl rand -base64 32
#
# Legacy X-API-Key compatibility. An already-shipped private build contains the
# current value; never put this or its replacement in a new app binary.
API_KEY=
# Separate secret for /internal/* endpoints (X-Cron-Secret). Must match the
# CRON_SECRET repo secret used by the manual trigger fallback and check-missed cron.
# Never put it in the app.
CRON_SECRET=

# Temporary founder migration credential for X-Founder-Claim-Token. Generate at
# least 32 random bytes (`openssl rand -hex 32`), keep it distinct from both
# secrets above, and delete it from the deployment after the returned bearer
# credentials are verified in Keychain. Hex avoids xcconfig comment characters;
# empty disables the claim route.
FOUNDER_CLAIM_TOKEN=
# Current private-build compatibility only. Set false as soon as the founder's
# bearer credentials are verified; public iOS builds must never carry API_KEY.
LEGACY_API_KEY_AUTH_ENABLED=false

# Production only: poll /internal/trigger-review from the single API process.
REVIEW_POLLER_ENABLED=false
# REVIEW_POLL_INTERVAL_SECONDS=900

ANTHROPIC_API_KEY=
# Keep at 1 until the V2-capable iOS build is deployed. Set to 2 to activate;
# rollback is setting it back to 1 and redeploying the API.
SCORING_CONTRACT_VERSION=1

# APNs token-based auth
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.christrinh.devmax
# .p8 file *contents*, not a path — paste the whole file including the BEGIN/END
# lines and keep the newlines. Railway's variable editor accepts multi-line values.
APNS_PRIVATE_KEY=
# Must track the iOS entitlement's aps-environment. A mismatch fails silently as
# BadDeviceToken: development profile -> true, production/TestFlight -> false.
APNS_USE_SANDBOX=true

# Sign in with Apple. The key can be distinct from the APNs key. These may stay
# empty while the founder compatibility build is running; public sign-in remains
# unavailable until all five are configured.
APPLE_CLIENT_ID=com.christrinh.devmax
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# URL-safe Fernet key for encrypting Apple's refresh token at rest.
AUTH_ENCRYPTION_KEY=
LLM_CALLS_PER_DAY=200
GUIDE_IMPORTS_PER_DAY=3
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=90

LOG_LEVEL=INFO
