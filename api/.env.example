# Neon connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:pass@host.neon.tech/warmcache

# Shared secret for the iOS client (X-API-Key)
API_KEY=change-me

# Separate secret for /internal/* endpoints (X-Cron-Secret)
CRON_SECRET=change-me-too

ANTHROPIC_API_KEY=

# APNs token-based auth
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.warmcache
# .p8 file *contents*, not a path
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true

LOG_LEVEL=INFO
