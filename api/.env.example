# Neon connection string, async driver.
#
# Use the DIRECT endpoint, not the pooled one (`...-pooler...`): PgBouncer in
# transaction mode is incompatible with asyncpg's prepared statements. Rewrite the
# scheme Neon gives you (`postgresql://`) to `postgresql+asyncpg://`. The trailing
# `?sslmode=require&channel_binding=require` is libpq-only and asyncpg rejects it —
# db.py strips it defensively and negotiates TLS itself, so you can paste either form.
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-west-2.aws.neon.tech/warmcache

# The app refuses to start if either of these is missing, empty, a known placeholder,
# or equal to the other one. Generate each separately:
#   openssl rand -base64 32
#
# Shared secret for the iOS client (X-API-Key). This one ships inside the app binary.
API_KEY=
# Separate secret for /internal/* endpoints (X-Cron-Secret). Must match the
# CRON_SECRET repo secret used by the GitHub Actions crons. Never put it in the app.
CRON_SECRET=

ANTHROPIC_API_KEY=

# APNs token-based auth
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.christrinh.warmcache
# .p8 file *contents*, not a path:  fly secrets set APNS_PRIVATE_KEY="$(cat AuthKey_XXXX.p8)"
APNS_PRIVATE_KEY=
# Must track the iOS entitlement's aps-environment. A mismatch fails silently as
# BadDeviceToken: development profile -> true, production/TestFlight -> false.
APNS_USE_SANDBOX=true

LOG_LEVEL=INFO
